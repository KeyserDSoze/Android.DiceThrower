<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="backup_restore_title">백업 및 복원</string>
    <string name="backup_restore_intro">캐릭터, 변수, 주사위 굴림, 레벨 규칙, 설정 및 굴림 기록의 로컬 백업을 만듭니다. Dice Thrower는 아무것도 업로드하지 않습니다.</string>
    <string name="backup_export_title">백업 내보내기</string>
    <string name="backup_export_description">Android 문서 선택기를 사용해 버전이 지정된 JSON 백업을 저장합니다. 파일 저장 위치는 직접 선택합니다.</string>
    <string name="backup_export_action">백업 파일 저장</string>
    <string name="backup_export_success">백업을 저장했습니다.</string>
    <string name="backup_import_title">백업 복원</string>
    <string name="backup_import_description">Dice Thrower 백업을 선택하세요. 로컬 데이터를 바꾸기 전에 파일을 검증합니다.</string>
    <string name="backup_import_action">백업 파일 선택</string>
    <string name="backup_import_confirm_title">로컬 Dice Thrower 데이터를 바꾸시겠습니까?</string>
    <string name="backup_import_confirm_body">검증된 이 백업에는 캐릭터 %1$d개와 굴림 %2$d개가 있습니다. 복원하면 현재 로컬 데이터와 설정이 교체됩니다.</string>
    <string name="backup_import_replace_action">복원 후 다시 시작</string>
    <string name="backup_image_warning">캐릭터 이미지는 백업 v2에 포함되고 복원 중 검증되므로 기기 간에 옮길 수 있습니다. 기존 v1 URI 참조도 접근 가능한 경우 계속 지원됩니다.</string>
    <string name="backup_invalid_file">이 파일은 유효한 Dice Thrower 백업이 아닙니다.</string>
    <string name="backup_unknown_error">백업 작업을 완료할 수 없습니다.</string>
    <string name="backup_shortcut_label">백업 및 복원</string>
    <string name="backup_shortcut_short">백업</string>
</resources>
